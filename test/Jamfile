project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# Every test runs with exceptions on and off (DESIGN, 2026-10-10 "every
# variant tested"): the second program has the suffix _no_exceptions and is
# built with exception-handling=off, which links tools/throw_exception.cpp.
rule crypto-run ( name : sources + : requirements * : targets * )
{
    webcpp.run $(name) : $(sources) : $(requirements) : $(targets) ;
    webcpp.run $(name)_no_exceptions : $(sources)
      : $(requirements) <exception-handling>off : $(targets) ;
}

webcpp.headers-alone crypto : ../include : crypto.hpp crypto/aes.hpp
  crypto/config.hpp crypto/equal.hpp crypto/error.hpp crypto/gcm.hpp
  crypto/random_device.hpp crypto/detail/engines.hpp crypto/detail/entropy.hpp
  crypto/detail/limits.hpp crypto/detail/windows.hpp crypto/detail/wipe.hpp ;

# The backend OpenSSL's header alone, with OpenSSL linked.
webcpp.headers-alone crypto : ../include : crypto/backends/openssl.hpp
  : <library>/webcpp/crypto//openssl : native wasip2 wasip3 ;
# The default backend's header, natively with OpenSSL linked, where OpenSSL is
# the default. Joins BearSSL's call, on every target, with backends/bearssl.hpp.
webcpp.headers-alone crypto : ../include : crypto/aes256_gcm.hpp
  : <library>/webcpp/crypto//openssl : native ;
# The backend ctaes's header alone, with ctaes linked, on every target.
webcpp.headers-alone crypto : ../include : crypto/backends/ctaes.hpp
  : <library>/third_party//ctaes ;
# libsecp256k1's headers compile alone only with its library, which defines
# WEBCPP_CRYPTO_HAS_SECP256K1 (without it, each stops with its message).
webcpp.headers-alone crypto : ../include : crypto/secp256k1.hpp crypto/backends/secp256k1.hpp
  : <library>/third_party//secp256k1 ;

# config.hpp defines WEBCPP_CRYPTO_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, keeps it when a developer defines it, defines it when
# WEBCPP_NO_EXCEPTIONS is, and classifies the target.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_no_exceptions : config_test.cpp : <exception-handling>off ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_ALL_OFF ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_CRYPTO_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_DEVELOPER_DEFINED ;

crypto-run error : error_test.cpp ;
crypto-run equal : equal_test.cpp ;
crypto-run wipe : wipe_test.cpp ;

# The counter itself: counts each allocation as it documents, on the first
# thread and a new one.
crypto-run counting : counting_test.cpp ;

