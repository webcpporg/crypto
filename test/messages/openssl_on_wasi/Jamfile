project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

# OpenSSL is a backend on wasip2 and wasip3, where the provider builds it:
# config.hpp refuses it on Emscripten alone. BearSSL stays the default.
webcpp.compile openssl_on_wasi : openssl_on_wasi.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 : wasip2 wasip3 ;
