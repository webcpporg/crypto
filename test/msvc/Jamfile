# Each message of the build on MSVC (spec section 8.6), a directory per case:
# on the CI's msvc lanes each case must fail to compile or to link. Its text
# is checked on clang, GNU ld and wasm-ld by tools/test/crypto_jamfiles_test.py;
# MSVC's is not checked (CODING-GUIDELINES.md chapter 19). Elsewhere than MSVC
# nothing here is built: the project's requirements make every case <build>no.
#
# A case is declared here with a build-project line once its sources exist:
# its directory holds its Jamfile, written beforehand, and the line is added
# in the commit that adds the sources the case needs. Each case waits below
# for what it needs.
rule msvc-only ( properties * )
{
    if ! ( <toolset>msvc in $(properties) )
    {
        return <build>no ;
    }
}

project : requirements <conditional>@msvc-only ;

build-project openssl_not_linked ;
build-project two_defaults ;
build-project canary_secp256k1_missing ;
build-project canary_secp256k1_small ;
build-project canary_ctaes_missing ;
build-project gcm_on_ctaes ;
