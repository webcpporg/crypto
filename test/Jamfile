  : <library>/third_party//bearssl <library>/webcpp/crypto//openssl
    <define>WEBCPP_CRYPTO_DETAIL_BEARSSL_PORTABLE
  : native wasip2 wasip3 ;

# libsodium, BearSSL and OpenSSL pairwise on ChaCha20-Poly1305 (spec section
# 8.2), on native, wasip2 and wasip3; on Emscripten, which has no OpenSSL,
# libsodium against BearSSL. The portable twins keep BearSSL on chacha20_ct
# and poly1305_ctmul through the backend's test seam, as AES-GCM's does: on
# x86-64 its other ChaCha20 is SSE2's, and wherever the compiler has 128-bit
# integers, the WebAssembly targets included, its other Poly1305 is ctmulq.
