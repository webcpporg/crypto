# The throughput of each family's fixed operation per backend (throughput.cpp,
# bench/operations.hpp), and the cost of the timing guard every operation runs
# in (timing.cpp). throughput_check and timing_check are the correctness tests
# of the measured programs, run in every lane of test/ (test/Jamfile builds
# this project): each operation checked once, never timed, and the guard's
# measurement run at 10^3 iterations, its line's form and the thread's DIT
# checked. The measurements themselves are made by hand by collect.py, which
# runs the programs built here at variant=release and writes
# doc/performance.adoc; no lane measures them.

project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;
import webcpp-target ;

webcpp.targets native wasip2 wasip3 emscripten ;

# OpenSSL on the targets that have it; Emscripten has none.
rule with-openssl ( properties * )
{
    if [ webcpp-target.target-of $(properties) ] in native wasip2 wasip3
    {
        return <library>/webcpp/crypto//openssl ;
    }
}

.requirements = <library>/third_party//bearssl <library>/third_party//ctaes
    <library>/third_party//secp256k1 <library>/third_party//sodium
    <conditional>@with-openssl ;
webcpp.run throughput_check : throughput.cpp : $(.requirements) ;

# The same program at variant=release, the one collect.py measures, built and
# run by hand (doc/performance.adoc); no lane measures it.
exe throughput : throughput.cpp : $(.requirements) <variant>release ;
explicit throughput ;

# The guard's cost needs no backend: detail/timing.hpp alone.
webcpp.run timing_check : timing.cpp ;

# The same program at variant=release, the one collect.py --timing measures,
# built and run by hand (doc/performance.adoc); no lane measures it.
exe timing : timing.cpp : <variant>release ;
explicit timing ;
