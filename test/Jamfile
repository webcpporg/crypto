webcpp.headers-alone crypto : ../include : crypto/backends/ctaes.hpp
  : <library>/third_party//ctaes ;
# The backend libsodium's header alone, and Ed25519's, X25519's, their key
# formats', crypto_kx's, the boxes' and the sealed boxes' with it, with
# libsodium linked, on every target (PEM's compiles alone without it, in the
# first list).
webcpp.headers-alone crypto : ../include
  : crypto/backends/sodium.hpp crypto/curves/ed25519.hpp crypto/curves/x25519.hpp
    crypto/curves/ed25519/formats.hpp crypto/curves/x25519/formats.hpp
    crypto/curves/x25519/kx.hpp crypto/hybrid/box.hpp crypto/hybrid/sealed_box.hpp
  : <library>/third_party//sodium ;
# libsecp256k1's headers compile alone only with its library, which defines
# WEBCPP_CRYPTO_HAS_SECP256K1 (without it, each stops with its message).
