import webcpp ;

webcpp.doc crypto : crypto.adoc ;
# The reference reads the backend headers, which refuse a build that does not
# link their library: it links OpenSSL, natively the default backend whose
# header aes256_gcm.hpp includes, ctaes and libsecp256k1.
webcpp.reference crypto : <library>/webcpp/crypto//openssl <library>/third_party//ctaes
  <library>/third_party//secp256k1 ;
