# crypto: authenticated encryption, randomness, secp256k1, Ed25519 and X25519
# over C backends.
# A program names /webcpp/crypto//crypto and the library of each backend it
# uses, /third_party//<backend> (third_party/Jamfile), or, for OpenSSL,
# /webcpp/crypto//openssl; or, for a family's default backend on every
# target, /webcpp/crypto//<family>-default (the block at the end):
#
#     exe app : app.cpp /webcpp/crypto//crypto /webcpp/crypto//gcm-default ;

import webcpp-target ;

project /webcpp/crypto ;

# Header-only, on webcpp's configuration, with webcpp::hash's header-only
# alias, whose algorithms name a signature's prehash (Ed25519ph's SHA-512;
# design D1). random_device reads Windows' generator through bcrypt
# (BCryptGenRandom), a system library.
# tag::crypto[]
alias crypto : : : : <include>include <library>/boost//headers
  <library>/webcpp/config//config <library>/webcpp/hash//hash
  <target-os>windows:<find-shared-library>bcrypt ;
# end::crypto[]

# tag::openssl[]
# OpenSSL, the backend backends::openssl: the superproject's source-built
# OpenSSL 3.5.9 (/webcpp/third_party//openssl, static; CODING-GUIDELINES.md
# chapter 5 rule 7) with the define the backend's header checks, on native,
# wasip2 and wasip3. Never a system OpenSSL, never shared.
rule openssl-linked ( properties * )
{
    if [ webcpp-target.target-of $(properties) ] in native wasip2 wasip3
    {
        return <library>/webcpp/third_party//openssl
            <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 ;
    }
}

# Refused on Emscripten: every source of a program built for emscripten that
# names it stops at the forced include, whose message says what to write.
# Quoted, as the Jamroot quotes Boost's directory, for a path that holds a
# space.
path-constant WEBCPP_CRYPTO_ROOT : . ;
alias openssl : : : : <conditional>@openssl-linked
    <toolset>emscripten:<cflags>"-include \"$(WEBCPP_CRYPTO_ROOT)/src/openssl_on_emscripten.hpp\""
    <toolset>emscripten:<cxxflags>"-include \"$(WEBCPP_CRYPTO_ROOT)/src/openssl_on_emscripten.hpp\"" ;
# end::openssl[]

# generate.py: begin the defaults' aliases
# Generated by doc/tables/generate.py from doc/tables/crypto.json: run it
# again, never edit this block. Each family with a default backend has the
# alias /webcpp/crypto//<family>-default, which links the library of its
# default on each target, the backend detail/defaults.hpp chooses there.
rule gcm-default-linked ( properties * )
{
    switch [ webcpp-target.target-of $(properties) ]
    {
        case native : return <library>/webcpp/crypto//openssl ;
        case wasip2 : return <library>/third_party//bearssl ;
        case wasip3 : return <library>/third_party//bearssl ;
        case emscripten : return <library>/third_party//bearssl ;
    }
}
alias gcm-default : : : : <conditional>@gcm-default-linked ;
rule secp256k1-default-linked ( properties * )
{
    switch [ webcpp-target.target-of $(properties) ]
    {
        case native : return <library>/third_party//secp256k1 ;
        case wasip2 : return <library>/third_party//secp256k1 ;
        case wasip3 : return <library>/third_party//secp256k1 ;
        case emscripten : return <library>/third_party//secp256k1 ;
    }
}
alias secp256k1-default : : : : <conditional>@secp256k1-default-linked ;
