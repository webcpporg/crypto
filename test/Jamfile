project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# Every test runs with exceptions on and off (DESIGN, 2026-10-10 "every
# variant tested"): the second program has the suffix _no_exceptions and is
# built with exception-handling=off, which links tools/throw_exception.cpp.
rule crypto-run ( name : sources + : requirements * : targets * )
{
    webcpp.run $(name) : $(sources) : $(requirements) : $(targets) ;
    webcpp.run $(name)_no_exceptions : $(sources)
      : $(requirements) <exception-handling>off : $(targets) ;
}

webcpp.headers-alone crypto : ../include : crypto.hpp crypto/config.hpp
  crypto/equal.hpp crypto/error.hpp crypto/ciphers/aes.hpp crypto/ciphers/gcm.hpp
  crypto/random_device.hpp crypto/detail/declassify.hpp crypto/detail/engines.hpp
  crypto/detail/entropy.hpp crypto/detail/limits.hpp crypto/detail/windows.hpp
  crypto/detail/wipe.hpp crypto/secret.hpp ;

# The backend BearSSL's header and the default backend's, with BearSSL linked,
# on every target.
webcpp.headers-alone crypto : ../include
  : crypto/ciphers/aes256_gcm.hpp crypto/backends/bearssl.hpp
  : <library>/third_party//bearssl ;
# The backend OpenSSL's header, with OpenSSL linked and selected; BearSSL, ctaes
# and libsecp256k1 are linked too, so that every public header compiles with
# these options (the lint's aggregate translation unit,
# tools/lint/compile_commands.py).
webcpp.headers-alone crypto : ../include : crypto/backends/openssl.hpp
  : <library>/webcpp/crypto//openssl <library>/third_party//bearssl
    <library>/third_party//ctaes <library>/third_party//secp256k1
    <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_OPENSSL
  : native wasip2 wasip3 ;
# The backend ctaes's header alone, with ctaes linked, on every target.
webcpp.headers-alone crypto : ../include : crypto/backends/ctaes.hpp
  : <library>/third_party//ctaes ;
# The backend libsodium's header alone, with libsodium linked, on every target.
webcpp.headers-alone crypto : ../include : crypto/backends/sodium.hpp
  : <library>/third_party//sodium ;
# libsecp256k1's headers compile alone only with its library, which defines
# WEBCPP_CRYPTO_HAS_SECP256K1 (without it, each stops with its message).
webcpp.headers-alone crypto : ../include
  : crypto/curves/secp256k1.hpp crypto/backends/secp256k1.hpp
  : <library>/third_party//secp256k1 ;

# config.hpp defines WEBCPP_CRYPTO_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, keeps it when a developer defines it, defines it when
# WEBCPP_NO_EXCEPTIONS is, and classifies the target.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_no_exceptions : config_test.cpp : <exception-handling>off ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_ALL_OFF ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_CRYPTO_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_DEVELOPER_DEFINED ;

crypto-run error : error_test.cpp ;
crypto-run equal : equal_test.cpp ;
# <webcpp/crypto.hpp> alone, with no backend linked, compiles, links and runs.
crypto-run convenience_header : convenience_header_test.cpp ;
crypto-run wipe : wipe_test.cpp ;
# secret<N> is not copyable, moves wipe the source, and the destructor wipes the storage, at -O2.
crypto-run secret : secret_test.cpp : <optimization>speed ;

# A destroyed or moved-from key schedule is zero in its storage, read at -O2
# where a dropped store would show: one program per keyed type, one source.
crypto-run wipe_objects_bearssl : wipe_objects_test.cpp
  : <library>/third_party//bearssl <define>WEBCPP_TEST_WIPE_BEARSSL <optimization>speed ;
crypto-run wipe_objects_ctaes : wipe_objects_test.cpp
  : <library>/third_party//ctaes <define>WEBCPP_TEST_WIPE_CTAES <optimization>speed ;
crypto-run wipe_objects_secp256k1 : wipe_objects_test.cpp
  : <library>/third_party//secp256k1 <define>WEBCPP_TEST_WIPE_SECP256K1 <optimization>speed ;
crypto-run wipe_objects_openssl : wipe_objects_test.cpp
  : <library>/webcpp/crypto//openssl <define>WEBCPP_TEST_WIPE_OPENSSL <optimization>speed
  : native wasip2 wasip3 ;

