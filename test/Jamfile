project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# Every test runs with exceptions on and off (DESIGN, 2026-10-10 "every
# variant tested"): the second program has the suffix _no_exceptions and is
# built with exception-handling=off, which links tools/throw_exception.cpp.
rule crypto-run ( name : sources + : requirements * : targets * )
{
    webcpp.run $(name) : $(sources) : $(requirements) : $(targets) ;
    webcpp.run $(name)_no_exceptions : $(sources)
      : $(requirements) <exception-handling>off : $(targets) ;
}

webcpp.headers-alone crypto : ../include : crypto.hpp crypto/config.hpp crypto/error.hpp
  crypto/equal.hpp crypto/detail/wipe.hpp crypto/detail/limits.hpp ;
webcpp.headers-alone crypto : ../include : crypto.hpp crypto/aes.hpp crypto/config.hpp crypto/error.hpp
  crypto/gcm.hpp
  crypto/detail/engines.hpp crypto/detail/limits.hpp crypto/detail/wipe.hpp ;

# config.hpp defines WEBCPP_CRYPTO_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, keeps it when a developer defines it, defines it when
# WEBCPP_NO_EXCEPTIONS is, and classifies the target.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_no_exceptions : config_test.cpp : <exception-handling>off ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_ALL_OFF ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_CRYPTO_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_DEVELOPER_DEFINED ;

crypto-run error : error_test.cpp ;
crypto-run equal : equal_test.cpp ;
crypto-run wipe : wipe_test.cpp ;

# The counter itself: counts each allocation as it documents, on the first thread and a new one.
crypto-run counting : counting_test.cpp ;

# Declared with the BearSSL and OpenSSL backends, whose allocation tests are in this
# directory:
#crypto-run allocation_bearssl : allocation_bearssl_test.cpp : <library>/third_party//bearssl ;
#crypto-run allocation_openssl : allocation_openssl_test.cpp
#  : <library>/webcpp/crypto//openssl : native wasip2 wasip3 ;
#crypto-run bearssl_seeder : bearssl_seeder_test.cpp : <library>/third_party//bearssl ;

# asio's and crypto's OpenSSL in one program: one provider, each archive once
# (CODING-GUIDELINES.md chapter 5 rule 10).
crypto-run openssl_one_copy : openssl_one_copy_test.cpp
  : <library>/webcpp/crypto//openssl <library>/webcpp/asio//openssl : native wasip2 wasip3 ;

# Naming the alias refuses an Emscripten program, in C++ and in C, by the forced include.
webcpp.compile-fail openssl_named_on_emscripten : openssl_named_test.cpp
  : <library>/webcpp/crypto//openssl : emscripten ;
webcpp.compile-fail openssl_named_c_on_emscripten : openssl_named_c_test.c
  : <library>/webcpp/crypto//openssl : emscripten ;

build-project msvc ;

# The default backend (spec section 5), one combination of linked and selected
# backends per program, each on the targets where its answer holds.
webcpp.compile default_backend_none : default_backend_test.cpp
  : <define>WEBCPP_TEST_CRYPTO_EXPECT_NONE_LINKED ;
webcpp.compile default_backend_bearssl_linked : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 ;
webcpp.compile default_backend_bearssl_selected : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_BEARSSL ;
webcpp.compile default_backend_openssl_linked : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native ;
webcpp.compile default_backend_openssl_linked_wasi : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 : wasip2 wasip3 ;
webcpp.compile default_backend_both_linked : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_CRYPTO_HAS_BEARSSL=1
    <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native ;
webcpp.compile default_backend_both_linked_wasi : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 : wasip2 wasip3 ;
webcpp.compile default_backend_both_bearssl_selected : default_backend_test.cpp
    <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_BEARSSL : native ;
webcpp.compile default_backend_openssl_selected : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_OPENSSL

build-project messages ;

# The generic layer on the mock backend (support/mock_backend.hpp), whose checks
# (support/*_checks.hpp) every real backend's test runs as well.
crypto-run aes_mock : aes_mock_test.cpp ;
crypto-run gcm_mock : gcm_mock_test.cpp ;
# The limits need a 64-bit size_t and address space reserved without memory.
crypto-run gcm_limits_mock : gcm_limits_mock_test.cpp : : native ;

# read_canary's load survives optimisation: without the canary the program does
# not link, on every compiler; with it, it links and runs.
webcpp.link-fail canary_read_absent : canary_read_test.cpp : <optimization>speed ;
crypto-run canary_read : canary_read_test.cpp
  : <optimization>speed <define>WEBCPP_TEST_CRYPTO_DEFINE_CANARY ;
