project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

# alone: the two removed calls and the corrected call of fopen are the
# compile's only errors, on WASI, whose C library declares fopen; natively,
# seal_removed_call. The pinned arity text names wasi-libc's fopen as the
# pinned clang and wasi-sdk declare it, and may drift with their updates.
webcpp.compile-diagnostic seal_removed_call_wasi : seal_removed_call_wasi.cpp
  : : wasip2 wasip3 : alone ;
