project : requirements <library>/webcpp/crypto//crypto ;

import regex ;
import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# Every test runs with exceptions on and off (DESIGN, 2026-10-10 "every
# variant tested"): the second program has the suffix _no_exceptions and is
# built with exception-handling=off, which links tools/throw_exception.cpp.
rule crypto-run ( name : sources + : requirements * : targets * )
{
    webcpp.run $(name) : $(sources) : $(requirements) : $(targets) ;
    webcpp.run $(name)_no_exceptions : $(sources)
      : $(requirements) <exception-handling>off : $(targets) ;
}

# The requirements of a test that reads what an optimiser leaves: -O2, and on
# Emscripten no debug information, whose DWARF would hold back em++'s
# post-link optimisation, the wasm-opt a release build runs
# (-Wlimited-postlink-optimizations).
OPTIMISED = <optimization>speed <toolset>emscripten:<debug-symbols>off ;

webcpp.headers-alone crypto : ../include : crypto.hpp crypto/config.hpp
  crypto/equal.hpp crypto/error.hpp crypto/ciphers/aes.hpp crypto/ciphers/gcm.hpp
  crypto/random_device.hpp crypto/detail/bytes.hpp crypto/detail/declassify.hpp
  crypto/detail/engines.hpp crypto/detail/entropy.hpp crypto/detail/limits.hpp
  crypto/detail/windows.hpp crypto/detail/wipe.hpp crypto/secret.hpp
  crypto/supports.hpp crypto/detail/capabilities.hpp crypto/detail/defaults.hpp
  crypto/detail/heavy.hpp crypto/detail/timing.hpp crypto/ciphers/aead.hpp
  crypto/ciphers/chacha20_poly1305.hpp crypto/ciphers/secretbox.hpp crypto/pem.hpp ;

