project : requirements <library>/webcpp/crypto//crypto <library>/webcpp/crypto//ed25519-default ;

import webcpp ;

# alone: the missing name and the errors clang derives from it on the same line
# are the compile's only errors, so a regression that puts another error before
# or after them fails the test.
webcpp.compile-diagnostic ph_removed : ph_removed.cpp
  : : native wasip2 wasip3 : alone ;
