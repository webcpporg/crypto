# Constant time (spec section 8.3): Valgrind and MemorySanitizer on Linux, and
# dudect's statistics natively and under wasmtime, as the own lane
# constant-time, outside the ordinary lanes. Each deterministic check is shown
# to fail on a planted leak, a branch on a key byte. The paths are version
# 0.1's: BearSSL's AES-GCM make, seal and open, OpenSSL's make and seal (its
# open branches on the verdict inside OpenSSL, where webcpp cannot mark it
# public), ctaes's make, encrypt and decrypt, equal, and libsecp256k1's own
# ctime_tests.c. MemorySanitizer builds only with clang.
project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

webcpp.targets native wasip2 ;

webcpp.original node ;

# Valgrind and MemorySanitizer run on Linux alone: elsewhere their programs
# are not built, and the lane runs dudect_bearssl alone.
rule linux-only ( properties * )
{
    if ! <target-os>linux in $(properties)
    {
        return <build>no ;
    }
}

# The libraries the memcheck programs link: BearSSL, OpenSSL and ctaes.
CTGRIND = <library>/third_party//bearssl <library>/webcpp/crypto//openssl
    <library>/third_party//ctaes <variant>release <debug-symbols>on
    <conditional>@linux-only
    <define>WEBCPP_CRYPTO_DETAIL_CT_VALGRIND <webcpp-drive-timeout>300 ;

webcpp.drive ctgrind : ctgrind_test.cpp : $(CTGRIND) : valgrind.mjs : : native ;
# The planted leak: the same program must fail under memcheck.
webcpp.drive ctgrind_planted : ctgrind_planted_test.cpp
  : $(CTGRIND) <define>WEBCPP_TEST_CRYPTO_PLANTED_LEAK
  : valgrind.mjs : --expect-leak : native ;
# equal compiles in the user's translation unit, so it is checked at both
# optimisations of spec section 2.6, each a program of its own.
webcpp.drive ctgrind_speed : ctgrind_test.cpp : $(CTGRIND) <optimization>speed
  : valgrind.mjs : : native ;
webcpp.drive ctgrind_space : ctgrind_test.cpp : $(CTGRIND) <optimization>space
  : valgrind.mjs : : native ;

# MemorySanitizer's checking of what a function is passed and returns, eager
# since clang 16, is off: a value derived from a secret is passed and returned
# by design, and only a branch or an index on one is a leak. libsecp256k1's
# build turns it off for its ctime_tests in the same way (its configure.ac).
MSAN_FLAGS = -fsanitize=memory -fno-sanitize-memory-param-retval ;

# BearSSL's and ctaes's sources once more, instrumented, for MemorySanitizer
# alone (it reports falsely through code it did not compile), with
# third_party/Jamfile's defines for Linux and webcpp's canaries.
path-constant BEARSSL : ../../../../third_party/libs/bearssl ;
path-constant CTAES : ../../../../third_party/libs/bitcoin/src/crypto/ctaes ;
lib bearssl_msan
  : [ glob $(BEARSSL)/src/*.c $(BEARSSL)/src/*/*.c ] ../../src/canary_bearssl.c
  : <link>static <warnings>off <warnings-as-errors>off <include>$(BEARSSL)/inc
    <include>$(BEARSSL)/src <include>../../include <define>BR_RDRAND=0
    <define>BR_USE_URANDOM=0 <define>BR_USE_GETENTROPY=1 <define>_DEFAULT_SOURCE
    <cflags>$(MSAN_FLAGS) <conditional>@linux-only
  : : <include>$(BEARSSL)/inc <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 ;
explicit bearssl_msan ;
lib ctaes_msan : $(CTAES)/ctaes.c ../../src/canary_ctaes.c
  : <link>static <warnings>off <warnings-as-errors>off <include>$(CTAES)
    <include>../../include <cflags>$(MSAN_FLAGS) <conditional>@linux-only
  : : <include>$(CTAES) <define>WEBCPP_CRYPTO_HAS_CTAES=1 ;
explicit ctaes_msan ;

# BearSSL stays on its portable code, whose plain C MemorySanitizer follows
# exactly; the engine marks the tag's verdict public.
MSAN = <library>bearssl_msan <library>ctaes_msan
    <define>WEBCPP_CRYPTO_DETAIL_BEARSSL_PORTABLE <define>WEBCPP_CRYPTO_DETAIL_CT_MSAN
    <cxxflags>$(MSAN_FLAGS) <linkflags>-fsanitize=memory <variant>release
    <debug-symbols>on <conditional>@linux-only ;

webcpp.run msan : msan_test.cpp : $(MSAN) : native ;
# The planted leak under MemorySanitizer: passes only on MemorySanitizer's own
# report of it, never on any other failure.
webcpp.drive msan_planted : msan_planted_test.cpp
  : $(MSAN) <define>WEBCPP_TEST_CRYPTO_PLANTED_LEAK : msan_report.mjs : : native ;

# libsecp256k1's own constant-time test, src/ctime_tests.c, unchanged, with
# the library's sources compiled into the program as its CMake builds them
# (ctime_tests links the library, which must be built with the same checker's
# interface): with VALGRIND under memcheck, and with MemorySanitizer, which
# its checkmem.h prefers when the compiler has it.
path-constant SECP256K1 : ../../../../third_party/libs/secp256k1 ;
SECP256K1_CTIME = $(SECP256K1)/src/ctime_tests.c $(SECP256K1)/src/secp256k1.c
    $(SECP256K1)/src/precomputed_ecmult.c
    $(SECP256K1)/src/precomputed_ecmult_gen.c ;
webcpp.drive secp256k1_ctime : $(SECP256K1_CTIME)
  : <library>/third_party//secp256k1-test-config <warnings>off
    <warnings-as-errors>off <define>VALGRIND <variant>release <debug-symbols>on
    <webcpp-drive-timeout>600 <conditional>@linux-only
  : valgrind.mjs : : native ;
webcpp.run secp256k1_ctime_msan : $(SECP256K1_CTIME)
  : <library>/third_party//secp256k1-test-config <warnings>off
    <warnings-as-errors>off <cflags>$(MSAN_FLAGS) <linkflags>-fsanitize=memory
    <variant>release <debug-symbols>on <conditional>@linux-only : native ;

# dudect's statistics on BearSSL, ctaes and equal, natively and under wasmtime.
webcpp.run dudect_bearssl : dudect_test.cpp
  : <library>/third_party//bearssl <library>/third_party//ctaes <variant>release
  : native wasip2 ;

webcpp.lane constant-time : ctgrind ctgrind_planted ctgrind_speed ctgrind_space
    msan msan_planted secp256k1_ctime secp256k1_ctime_msan dudect_bearssl
  : native wasip2 ;
