project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# The guide's secp256k1 program: BIP340's first vector signed and verified, then
# the key pair tweaked and used again.
webcpp.example schnorr_sign.cpp : <library>/third_party//secp256k1 ;

# AES-256-GCM with the backend named, against the GCM spec's test case 14.
# tag::aes256_gcm_bearssl[]
webcpp.example aes256_gcm_bearssl.cpp : <library>/third_party//bearssl ;
# end::aes256_gcm_bearssl[]

# A Boost.Hash2 HMAC tag compared in constant time with equal; no backend.
webcpp.example equal_hmac.cpp ;

# BearSSL's HMAC-DRBG seeded from random_device.
webcpp.example bearssl_prng.cpp : <library>/third_party//bearssl ;

# The three ways AES-GCM refuses a message, on the default backend.
webcpp.example failure_reasons.cpp : <library>/webcpp/crypto//gcm-default ;

# A reset token and a one-time code from random_device; no backend.
webcpp.example reset_token.cpp ;

# An API token stored in a row, bound to the user id as additional data.
webcpp.example store_token.cpp : <library>/webcpp/crypto//gcm-default ;

# The incremental seal, and records bound to their numbers.
webcpp.example sealed_records.cpp : <library>/webcpp/crypto//gcm-default ;

# An order id turned into an opaque reference with the raw AES block cipher.
webcpp.example order_reference.cpp : <library>/third_party//ctaes ;

# A Schnorr signature over a message id, verified by a reader.
webcpp.example signed_message.cpp : <library>/third_party//secp256k1 ;

# An ECDSA-signed software update checked with a shipped public key.
webcpp.example signed_update.cpp : <library>/third_party//secp256k1 ;

# ECDH, HKDF-SHA-256 and AES-256-GCM between two peers.
webcpp.example ecdh_session.cpp : <library>/third_party//secp256k1 <library>/webcpp/crypto//gcm-default ;

# A wallet's key pair, its secret sealed at rest and restored.
webcpp.example wallet_key.cpp : <library>/third_party//secp256k1 <library>/webcpp/crypto//gcm-default ;

# ECDSA with DER encoding and the low-S rule, as a domain library uses them.
webcpp.example ecdsa_der.cpp : <library>/third_party//secp256k1 ;

# BIP341 key-path tweak of an internal key and a signature under the output key.
webcpp.example taproot_tweak.cpp : <library>/third_party//secp256k1 ;

# The key pair's one allocation counted in the program's own arena.
webcpp.example arena_signer.cpp : <library>/third_party//secp256k1 ;

# OpenSSL's allocations sent to the program's own resource, natively only: the
# define and OpenSSL given together, as a program's project requirements give
# them (doc/jamfile.adoc); its work runs on a thread of its own.
# tag::openssl_memory[]
webcpp.example openssl_memory.cpp
  : <define>WEBCPP_CRYPTO_OPENSSL_MEMORY_RESOURCE <library>/webcpp/crypto//openssl
    <threading>multi
  : native ;
# end::openssl_memory[]

# The guide's Ed25519 program: RFC 8032's second test signed and verified, then
# Ed25519ph's test given in two pieces, on the family's default.
webcpp.example ed25519_sign.cpp : <library>/webcpp/crypto//ed25519-default ;

# The guide's X25519 program: RFC 7748's Alice and Bob, the agreement of two
# Ed25519 key pairs through their X25519 forms, and a peer of low order
# refused, on the family's default.
webcpp.example x25519_agree.cpp : <library>/webcpp/crypto//x25519-default ;
