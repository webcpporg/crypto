project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;
import webcpp-target ;

# heavy_without_threads with clang's error limit at 1, which pins the order of
# its two errors (see the source). Natively Boost.Config always sees threads,
# so the build without them defines WEBCPP_CRYPTO_NO_THREADS; WASI has none of
# its own.
rule without-threads ( properties * )
{
    if [ webcpp-target.target-of $(properties) ] = native
    {
        return <define>WEBCPP_CRYPTO_NO_THREADS ;
    }
}

webcpp.compile-diagnostic heavy_without_threads_first
  : heavy_without_threads_first.cpp
  : <conditional>@without-threads <cxxflags>-ferror-limit=1 : native wasip2 wasip3
  : alone ;
