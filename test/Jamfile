# config.hpp defines WEBCPP_CRYPTO_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, keeps it when a developer defines it, defines it when
# WEBCPP_NO_EXCEPTIONS is, and classifies the target.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_no_exceptions : config_test.cpp : <exception-handling>off ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_ALL_OFF ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_CRYPTO_NO_EXCEPTIONS <define>WEBCPP_TEST_CRYPTO_DEVELOPER_DEFINED ;

# config.hpp defines WEBCPP_CRYPTO_HAS_THREADS by design D23's rule: natively
# with b2's threading=single (where Boost.Config's BOOST_HAS_THREADS decides),
# with threading=multi, and with WEBCPP_CRYPTO_NO_THREADS; on WebAssembly
# without -pthread (Emscripten with -pthread is the fixture
# threads_on_emscripten of tools/test/crypto_jamfiles_test.py).
webcpp.compile threads_config_single : threads_config_test.cpp
  : <threading>single <define>WEBCPP_TEST_CRYPTO_THREADING_SINGLE : native ;
webcpp.compile threads_config_multi : threads_config_test.cpp
  : <threading>multi <define>WEBCPP_TEST_CRYPTO_THREADING_MULTI : native ;
webcpp.compile threads_config_opted_out : threads_config_test.cpp
  : <threading>multi <define>WEBCPP_CRYPTO_NO_THREADS : native ;
webcpp.compile threads_config_wasm : threads_config_test.cpp : : wasip2 wasip3 emscripten ;
# A heavy operation's async_ variant with threads: detail::run_heavy runs the
# work on a thread_pool and completes on the caller's io_context.
crypto-run heavy : heavy_test.cpp : <threading>multi : native ;
# Without threads (WEBCPP_CRYPTO_NO_THREADS natively; WASI has none), a heavy
# operation's async_ variant that forgets its refusal stops at
# detail::run_heavy's stand-in, which names the refusal, and with that alone.
webcpp.compile-diagnostic heavy_refusal_forgotten : heavy_refusal_forgotten_test.cpp
  : <define>WEBCPP_CRYPTO_NO_THREADS : native wasip2 wasip3 : alone ;

