# node's WebCrypto as an outside oracle of Ed25519 and X25519, on Emscripten
# (EM_ASYNC_JS under the JSPI link, as webcpp::hash's webcrypto_oracle): 200
# seeded Ed25519 key pairs, messages and signatures, each verified and signed
# again by WebCrypto, and 200 X25519 agreements, each derived again; it prints
# `oracle ok 400`. oracle_25519_corrupted flips one signature and one shared
# secret and passes only when WebCrypto disagrees on exactly those two cases.
crypto-run oracle_25519 : oracle_25519_test.cpp
  : <library>/third_party//sodium <linkflags>-sJSPI : emscripten ;
crypto-run oracle_25519_corrupted : oracle_25519_test.cpp
  : <library>/third_party//sodium <linkflags>-sJSPI
    <define>WEBCPP_TEST_CRYPTO_ORACLE_CORRUPTED : emscripten ;

# RFC 8410's SPKI and PKCS#8 for Ed25519 and X25519, and PEM, on libsodium
# (design D30): RFC 8410's own keys, round trips of random keys, every
# malformed input refused with invalid_encoding and nothing written. OpenSSL's
# i2d_PUBKEY, i2d_PrivateKey and PEM writers as an outside oracle on native,
# wasip2 and wasip3 (linked in the test alone), and node's WebCrypto importKey
# and exportKey on Emscripten (the JSPI link, for EM_ASYNC_JS): 200 seeded
# cases per curve each.
# PEM's generic layer on a stand-in whose base64 decoder is lenient: unarmour's
# own checks refuse what armour does not write, whatever the backend takes, and
# a backend failing on the second pass leaves no byte of the DER in the output.
crypto-run pem_mock : pem_mock_test.cpp ;
crypto-run formats_25519_sodium : formats_25519_sodium_test.cpp
  : <library>/third_party//sodium ;
crypto-run formats_25519_openssl_oracle : formats_25519_openssl_oracle_test.cpp
  : <library>/third_party//sodium <library>/webcpp/crypto//openssl : native wasip2 wasip3 ;
crypto-run formats_25519_webcrypto_oracle : formats_25519_webcrypto_oracle_test.cpp
  : <library>/third_party//sodium <linkflags>-sJSPI : emscripten ;

# crypto_kx on libsodium: libsodium's kx.exp, the client's transmit key the
# server's receive key and the reverse, a peer of small order refused as weak,
# the guards and generate() under the planted entropy source. The key pair's
# secret key, kx.exp's client_sk, is zero once moved from, moved over and
# destroyed, and the session keys once destroyed: optimised, every call
# inlined, as Ed25519's.
crypto-run kx_sodium : kx_sodium_test.cpp
  : <library>/third_party//sodium <define>WEBCPP_CRYPTO_DETAIL_TEST_ENTROPY ;
crypto-run kx_wipe_sodium : kx_wipe_sodium_test.cpp
  : <library>/third_party//sodium $(OPTIMISED) <inlining>full ;

