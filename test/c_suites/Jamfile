# The C libraries' own test programs, built against webcpp's build of each, on
# every target (CODING-GUIDELINES.md chapter 5, rule 11). BearSSL's 88 tests
# take 116 to 126 s of CPU per target in a debug build, so they are the own lane
# c-suites, outside the ordinary lanes. The program's main is
# bearssl_bound.cpp's, which runs BearSSL's only when it is given the argument
# all, and fails otherwise: upstream's main lists its tests and returns 0 for
# any other argument, which would read green.
#
# libsodium's own suite is not repeated here: webcpp::hash's lane c-suites
# (libs/hash/test/c_suites/Jamfile) runs all of libsodium's test/default
# programs, each compared with its .exp, on every target, against the same
# archive /third_party//sodium that crypto links, canary included. Among them
# are the programs of crypto's operations on libsodium: sign, box, box2, box7,
# box8, box_easy (crypto_box_easy), box_easy2 (crypto_box_beforenm and the
# detached functions after it), box_seal, secretbox, secretbox2, secretbox7,
# secretbox8, secretbox_easy, secretbox_easy2 (the detached secret box),
# xchacha20 (the XChaCha20 box and secret box), aead_chacha20poly1305,
# aead_chacha20poly13052, aead_xchacha20poly1305, kx, scalarmult,
# ed25519_convert and codecs (the base64 functions PEM's engine calls).
import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

path-constant BEARSSL : ../../../../third_party/libs/bearssl ;
webcpp.run bearssl_test_crypto : $(BEARSSL)/test/test_crypto.c bearssl_bound.cpp
  : <testing.arg>all <library>/third_party//bearssl
    <library>/third_party//bearssl-test-config <define>main=bearssl_test_main
    <warnings>off <warnings-as-errors>off ;

# ctaes's own test program (spec section 8.1): asserts, so NDEBUG stays off. It
# is fast, so it is not in the lane c-suites: it runs on every ordinary lane, on
# every compiler, which the lane's four toolsets would only repeat.
path-constant CTAES : ../../../../third_party/libs/bitcoin/src/crypto/ctaes ;
webcpp.run ctaes_test : $(CTAES)/test.c : <library>/third_party//ctaes <warnings>off
  <warnings-as-errors>off <undef>NDEBUG ;

# libsecp256k1's tests, which include secp256k1.c and so compile the library
# again, with third_party/Jamfile's configuration of it (secp256k1-test-config:
# its modules and its tables) and VERIFY, as libsecp256k1's CMake builds them.
# The archive webcpp links is tested by the vectors of the library's own tests.
path-constant SECP256K1 : ../../../../third_party/libs/secp256k1 ;
# Optimised in every variant: VERIFY's checks at -O0 under wasmtime and node
# would not end within the own-lanes job's 60 minutes. The framework runs 16
# iterations of each test; measured on 2026-11-14, on a machine at load 100 to
# 160: native 106 s, Emscripten under node 477 s (above the support's 120 s, so
# secp256k1_tests_bound.cpp re-arms node's bound), wasip2 774 s, above the 600 s
# bound of tools/boost/asio-wasip2/run.sh and asio-wasip3/run.sh, which stopped
# both WASI runs. On WASI it runs 4 iterations, so that it ends within that
# bound (220 s on wasip2, 218 s on wasip3, the same day; a ruling of the
# controller, 2026-11-14, accepted it); natively and on Emscripten 16, as
# libsecp256k1's CI runs it.
webcpp.run secp256k1_tests : $(SECP256K1)/src/tests.c
    $(SECP256K1)/src/precomputed_ecmult.c $(SECP256K1)/src/precomputed_ecmult_gen.c
  : <library>/third_party//secp256k1-test-config <warnings>off <warnings-as-errors>off
    <define>VERIFY <optimization>speed
    <toolset>emscripten:<source>secp256k1_tests_bound.cpp
    <target-os>wasi:<testing.arg>--iterations=4 ;

# The lane names its targets, so that the CI runs it on each (an own lane that
# names none runs natively alone, tools/webcpp.jam's lane rule).
webcpp.lane c-suites : bearssl_test_crypto secp256k1_tests : native wasip2 wasip3 emscripten ;
