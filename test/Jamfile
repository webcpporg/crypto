# The twelve Ed25519 edge cases of "Taming the many EdDSAs" (design D31):
# each backend's raw verdict and strict's against meta/ed25519_cases.json, read
# at run time from the directory WEBCPP_TEST_CRYPTO_META gives, quoted as
# wycheproof's is, with forward slashes, and preopened on WASI; on Emscripten
# node's WebCrypto too, the outside view (the JSPI link, for EM_ASYNC_JS).
path-constant CRYPTO_TEST_META : ../meta ;
.crypto-meta = [ regex.replace $(CRYPTO_TEST_META) "\\\\" "/" ] ;
crypto-run ed25519_speccheck : ed25519_speccheck_test.cpp
  : <library>/third_party//sodium <library>/third_party//ed25519-speccheck
    <library>/webcpp//boost_json
    <define>"\"WEBCPP_TEST_CRYPTO_META=\\\"$(.crypto-meta)\\\"\""
    [ webcpp.data $(CRYPTO_TEST_META) ]
    <dependency>../meta/ed25519_cases.json
    <toolset>emscripten:<linkflags>-sJSPI ;

