# asio's and crypto's OpenSSL in one program: one provider, each archive once
# (CODING-GUIDELINES.md chapter 5 rule 10).
crypto-run openssl_one_copy : openssl_one_copy_test.cpp
  : <library>/webcpp/crypto//openssl <library>/webcpp/asio//openssl : native wasip2 wasip3 ;

# Naming the alias refuses an Emscripten program, in C++ and in C, by the
# forced include.
webcpp.compile-fail openssl_named_on_emscripten : openssl_named_test.cpp
  : <library>/webcpp/crypto//openssl : emscripten ;
webcpp.compile-fail openssl_named_c_on_emscripten : openssl_named_c_test.c
  : <library>/webcpp/crypto//openssl : emscripten ;

build-project msvc ;

# The default backend (spec section 5), one combination of linked and selected
# backends per program, each on the targets where its answer holds.
webcpp.compile default_backend_none : default_backend_test.cpp
  : <define>WEBCPP_TEST_CRYPTO_EXPECT_NONE_LINKED ;
webcpp.compile default_backend_bearssl_linked : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 ;
webcpp.compile default_backend_bearssl_selected : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_BEARSSL ;
webcpp.compile default_backend_openssl_linked : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native ;
webcpp.compile default_backend_openssl_linked_wasi : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 : wasip2 wasip3 ;
webcpp.compile default_backend_both_linked : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_CRYPTO_HAS_BEARSSL=1
    <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native ;
webcpp.compile default_backend_both_linked_wasi : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 : wasip2 wasip3 ;
webcpp.compile default_backend_both_bearssl_selected : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_CRYPTO_HAS_BEARSSL=1
    <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_BEARSSL : native ;
webcpp.compile default_backend_openssl_selected : default_backend_test.cpp
  : <define>WEBCPP_CRYPTO_HAS_OPENSSL=1 <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_OPENSSL
    <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native wasip2 wasip3 ;

# aes128_gcm, aes256_gcm and aes256<> name the default backend (spec section 5),
# checked from the defines alone against stand-ins for the backends' headers
# (support/fake_backends). b2 orders include paths, so the library's include/
# comes first: the test includes the stand-ins first, under the real headers'
# guards; the directory serves a backend whose real header is not in the tree.
webcpp.compile default_selection_openssl : default_selection_test.cpp
  : <include>support/fake_backends <define>WEBCPP_CRYPTO_HAS_OPENSSL=1
    <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native ;
webcpp.compile default_selection_openssl_alone : default_selection_test.cpp
  : <include>support/fake_backends <define>WEBCPP_CRYPTO_HAS_OPENSSL=1
    <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native ;
webcpp.compile default_selection_both_wasm : default_selection_test.cpp
  : <include>support/fake_backends <define>WEBCPP_CRYPTO_HAS_OPENSSL=1
    <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 : wasip2 wasip3 ;
webcpp.compile default_selection_bearssl : default_selection_test.cpp
  : <include>support/fake_backends <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 ;
webcpp.compile default_selection_bearssl_selected : default_selection_test.cpp
  : <include>support/fake_backends <define>WEBCPP_CRYPTO_HAS_OPENSSL=1
    <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_BEARSSL
    : native wasip2 wasip3 ;
webcpp.compile default_selection_openssl_selected : default_selection_test.cpp
  : <include>support/fake_backends <define>WEBCPP_CRYPTO_HAS_OPENSSL=1
    <define>WEBCPP_CRYPTO_HAS_BEARSSL=1 <define>WEBCPP_CRYPTO_DEFAULT_BACKEND_OPENSSL
    <define>WEBCPP_TEST_CRYPTO_EXPECT_OPENSSL : native wasip2 wasip3 ;

crypto-run secp256k1 : secp256k1_test.cpp : <library>/third_party//secp256k1 ;
crypto-run secp256k1_allocation : secp256k1_allocation_test.cpp
  : <library>/third_party//secp256k1 ;
crypto-run secp256k1_bip340 : secp256k1_bip340_test.cpp
  : <library>/third_party//secp256k1 <library>/third_party//bips ;
crypto-run secp256k1_wycheproof : secp256k1_wycheproof_test.cpp
  : <library>/third_party//secp256k1 <library>/third_party//wycheproof
    <library>/webcpp//boost_json ;

build-project messages ;

# The generic layer on the mock backend (support/mock_backend.hpp), whose checks
# (support/*_checks.hpp) every real backend's test runs as well.
crypto-run aes_mock : aes_mock_test.cpp ;
crypto-run gcm_mock : gcm_mock_test.cpp ;
# The limits need a 64-bit size_t and address space reserved without memory.
crypto-run gcm_limits_mock : gcm_limits_mock_test.cpp : : native ;

# read_canary's load survives optimisation: without the canary the program does
# not link, on every compiler; with it, it links and runs.
webcpp.link-fail canary_read_absent : canary_read_test.cpp : <optimization>speed ;
crypto-run canary_read : canary_read_test.cpp
  : <optimization>speed <define>WEBCPP_TEST_CRYPTO_DEFINE_CANARY ;

# random_device: the system's generator, and a planted failing source.
crypto-run random_device : random_device_test.cpp ;
crypto-run random_device_failing : random_device_failing_test.cpp
  : <define>WEBCPP_CRYPTO_DETAIL_TEST_ENTROPY ;
webcpp.compile-diagnostic random_device_no_call : random_device_no_call_test.cpp
  : <define>WEBCPP_CRYPTO_NO_EXCEPTIONS : native wasip2 ;

# The C libraries' own suites, in the own lane c-suites.
build-project c_suites ;

# The backend OpenSSL: the source-built OpenSSL 3.5.9 on native, wasip2 and
# wasip3 (Task 11); Emscripten has none.
crypto-run gcm_openssl : gcm_openssl_test.cpp : <library>/webcpp/crypto//openssl
  : native wasip2 wasip3 ;
# The limits need 64-bit sizes: natively, as BearSSL's twin.
crypto-run gcm_limits_openssl : gcm_limits_openssl_test.cpp
  : <library>/webcpp/crypto//openssl : native ;
