  : <library>/third_party//bearssl ;
# The backend OpenSSL's header, with OpenSSL linked; BearSSL,
# ctaes, libsecp256k1 and libsodium are linked too, so that every public
# header compiles with these options (the lint's aggregate translation unit,
# tools/lint/compile_commands.py).
webcpp.headers-alone crypto : ../include : crypto/backends/openssl.hpp
  : <library>/webcpp/crypto//openssl <library>/third_party//bearssl
    <library>/third_party//ctaes <library>/third_party//secp256k1
    <library>/third_party//sodium
  : native wasip2 wasip3 ;
