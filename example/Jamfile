project : requirements <library>/webcpp/crypto//crypto ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

# The guide's secp256k1 program: BIP340's first vector signed and verified, then
# the key pair tweaked and used again.
webcpp.example schnorr_sign.cpp : <library>/third_party//secp256k1 ;

# AES-256-GCM with the backend named, against the GCM spec's test case 14.
# tag::aes256_gcm_bearssl[]
webcpp.example aes256_gcm_bearssl.cpp : <library>/third_party//bearssl ;
# end::aes256_gcm_bearssl[]

# A Boost.Hash2 HMAC tag compared in constant time with equal; no backend.
webcpp.example equal_hmac.cpp ;

# BearSSL's HMAC-DRBG seeded from random_device.
webcpp.example bearssl_prng.cpp : <library>/third_party//bearssl ;

# The three ways AES-GCM refuses a message, on the default backend.
webcpp.example failure_reasons.cpp : <library>/webcpp/crypto//gcm-default ;

# A reset token and a one-time code from random_device; no backend.
webcpp.example reset_token.cpp ;

# An API token stored in a row, bound to the user id as additional data.
webcpp.example store_token.cpp : <library>/webcpp/crypto//gcm-default ;

# The incremental seal, and records bound to their numbers.
webcpp.example sealed_records.cpp : <library>/webcpp/crypto//gcm-default ;

# An order id turned into an opaque reference with the raw AES block cipher.
webcpp.example order_reference.cpp : <library>/third_party//ctaes ;

# A Schnorr signature over a message id, verified by a reader.
webcpp.example signed_message.cpp : <library>/third_party//secp256k1 ;

# An ECDSA-signed software update checked with a shipped public key.
webcpp.example signed_update.cpp : <library>/third_party//secp256k1 ;

# ECDH, HKDF-SHA-256 and AES-256-GCM between two peers.
webcpp.example ecdh_session.cpp : <library>/third_party//secp256k1 <library>/webcpp/crypto//gcm-default ;

# ECDH's raw x coordinate, and the NIP-44 conversation key a domain library
# derives from it.
webcpp.example ecdh_x_coordinate.cpp : <library>/third_party//secp256k1 ;

# A recoverable signature: a reader finds the signer's key from the signature
# and the hash.
webcpp.example recover_signer.cpp : <library>/third_party//secp256k1 ;

# A watch-only wallet: the same tweak on the public key and on the secret key,
# and a signature of the tweaked key pair verified under the tweaked public key.
webcpp.example key_tweak.cpp : <library>/third_party//secp256k1 ;

# A server's secp256k1 key in files OpenSSL reads: its public key as PEM SPKI
# for a configuration file, its key pair as PEM PKCS#8, each read back; PEM on
# its default, libsodium.
webcpp.example secp256k1_key_formats.cpp : <library>/third_party//secp256k1
  <library>/webcpp/crypto//pem-default ;

# Two peers send their keys as ElligatorSwift encodings, 64 bytes that look
# random, and agree on BIP 324's shared secret.
webcpp.example ellswift_handshake.cpp : <library>/third_party//secp256k1 ;

# A wallet split across two devices: their keys aggregated with MuSig2, two
# rounds of nonces and partial signatures, one BIP 340 signature on the chain.
webcpp.example musig_wallet.cpp : <library>/third_party//secp256k1 ;

# The same wallet with its devices apart: public nonces, the aggregate nonce and
# partial signatures cross the network as bytes, and the coordinator checks
# each part, refusing one damaged on the way.
webcpp.example musig_network.cpp : <library>/third_party//secp256k1 ;

# The wallet's aggregate key as a Taproot internal key: tweaked by its BIP 341
# TapTweak before any nonce, the signature verifies under the output key only.
webcpp.example musig_taproot.cpp : <library>/third_party//secp256k1 ;

# A donation page's one reusable address: a donor pays it, the recipient scans
# the transaction, finds the payment and spends it; a second payment to the
# address shares no output key with the first (BIP 352's silent payments).
webcpp.example silent_payment.cpp : <library>/third_party//secp256k1 ;

# A wallet's key pair, its secret sealed at rest and restored.
webcpp.example wallet_key.cpp : <library>/third_party//secp256k1 <library>/webcpp/crypto//gcm-default ;

# ECDSA with DER encoding and the low-S rule, as a domain library uses them.
webcpp.example ecdsa_der.cpp : <library>/third_party//secp256k1 ;

# BIP341 key-path tweak of an internal key and a signature under the output key.
webcpp.example taproot_tweak.cpp : <library>/third_party//secp256k1 ;

# The key pair's one allocation counted in the program's own arena.
webcpp.example arena_signer.cpp : <library>/third_party//secp256k1 ;

# OpenSSL's allocations sent to the program's own resource, natively only: the
# define and OpenSSL given together, as a program's project requirements give
# them (doc/jamfile.adoc); its work runs on a thread of its own.
# tag::openssl_memory[]
webcpp.example openssl_memory.cpp
  : <define>WEBCPP_CRYPTO_OPENSSL_MEMORY_RESOURCE <library>/webcpp/crypto//openssl
    <threading>multi
  : native ;
# end::openssl_memory[]

# The guide's Ed25519 program: RFC 8032's second test signed and verified, then
# Ed25519ph's test given in two pieces, on the family's default.
webcpp.example ed25519_sign.cpp : <library>/webcpp/crypto//ed25519-default ;

# The guide's P-256 key pair program: RFC 6979's key made from its scalar, its
# public key exported and imported as a peer's, a tampered point refused, and a
# key pair drawn from the system's generator.
webcpp.example p256_keys.cpp : <library>/webcpp/crypto//p256-default ;
# The guide's P-256 ECDSA program: RFC 6979's signature of "sample", its low-S
# form and its DER, both forms verified and another digest refused.
webcpp.example p256_sign.cpp : <library>/webcpp/crypto//p256-default ;
# The guide's P-256 ECDH program: two key pairs from fixed scalars agree on the
# shared x coordinate, then HKDF-SHA-256 derives a key from it.
webcpp.example p256_ecdh.cpp : <library>/webcpp/crypto//p256-default ;
# The guide's P-256 key formats program: RFC 6979's key written as PEM SPKI,
# printed, and as PEM PKCS#8, kept secret, each read back; PEM on its default,
# libsodium.
webcpp.example p256_key_formats.cpp : <library>/webcpp/crypto//p256-default
  <library>/webcpp/crypto//pem-default ;
# The guide's signed handshake on P-256 (doc/p2p.adoc): two peers' identities
# kept as scalars, the handshake's SHA-256 signed low S and checked low S first,
# a signature not normalized refused, and the session key from ECDH's x
# through HKDF-SHA-256.
webcpp.example p256_handshake.cpp : <library>/webcpp/crypto//p256-default ;

# The guide's X25519 program: RFC 7748's Alice and Bob, the agreement of two
# Ed25519 key pairs through their X25519 forms, and a peer of low order
# refused, on the family's default.
webcpp.example x25519_agree.cpp : <library>/webcpp/crypto//x25519-default ;

# The guide's key formats program: RFC 8410's Ed25519 key pair read from PEM,
# its public key written as PEM and a signature; an X25519 public key's SPKI;
# and the RFC's PKCS#8 version 2 refused, on the families' defaults.
webcpp.example key_formats.cpp : <library>/webcpp/crypto//ed25519-default
  <library>/webcpp/crypto//x25519-default <library>/webcpp/crypto//pem-default ;

# The guide's crypto_kx program: libsodium's kx test's client and server
# compute their session keys, the client seals a message the server opens on
# ChaCha20-Poly1305, and a peer of low order is refused, on the defaults.
webcpp.example kx_session.cpp : <library>/webcpp/crypto//kx-default
  <library>/webcpp/crypto//chacha20_poly1305-default ;

# A chat app's messages under one conversation key, each with a random nonce,
# on XChaCha20-Poly1305's default.
webcpp.example xchacha_seal.cpp
  : <library>/webcpp/crypto//xchacha20_poly1305-default ;

# A file-sharing app: the file in a secret box under its own key, the key in a
# sealed box to the recipient's X25519 public key, on the defaults.
webcpp.example file_share.cpp
  : <library>/webcpp/crypto//secretbox_xsalsa20poly1305-default
    <library>/webcpp/crypto//sealed_box-default
    <library>/webcpp/crypto//x25519-default ;

# Two people's boxes from each other's X25519 public keys, on the defaults.
webcpp.example box_messages.cpp
  : <library>/webcpp/crypto//box_xsalsa20poly1305-default
    <library>/webcpp/crypto//x25519-default ;
