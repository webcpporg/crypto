import webcpp ;

webcpp.compile-diagnostic aes_on_bearssl : aes_on_bearssl.cpp : : native wasip2 ;

# The refusal stays in the block cipher's functions: BearSSL's GCM, which names
# the cipher, compiles on every target.
webcpp.compile gcm_names_aes_on_bearssl : gcm_names_aes_on_bearssl.cpp
  : : native wasip2 wasip3 emscripten ;
